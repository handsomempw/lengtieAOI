    <Grid x:Name="MainLayoutRoot" Margin="3">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition x:Name="ToolStripRow" Height="auto" MaxHeight="160" MinHeight="100"/>
            <RowDefinition Height="auto" />
            <RowDefinition/>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition x:Name="ReportPanelColumn" Width="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3" MinHeight="30" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!-- 点检倒计时显示（不改变现有UI结构：嵌入到顶部区域） -->
            <Border x:Name="InspectionBanner" Grid.Row="0"
                    Background="{Binding DataModel.Processmodel.InspectionCountdownColor}"
                    Margin="0,0,0,6" Padding="10,5" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="点检倒计时" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding DataModel.Processmodel.TimeToNextInspectionText}"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding DataModel.Processmodel.InspectionStatusText}"
                               FontSize="12" VerticalAlignment="Center" Foreground="White"
                               Visibility="{Binding DataModel.Processmodel.IsInspectionActive, Converter={StaticResource Bool2Visible_Converter}}"/>
                    <Button Grid.Column="3"
                            Content="开始点检"
                            FontSize="13"
                            Padding="12,2"
                            Margin="10,0,0,0"
                            MinWidth="88"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#101010"
                            Foreground="WhiteSmoke"
                            p:ButtonHelper.CornerRadius="4"
                            ToolTip="手动开始点检。行为由配置数据.xml中“手动点检模式”控制：提前点检 / 强制到期；检测、报工或扫码处理中等待当前流程完成。"
                            IsEnabled="{Binding DataModel.Processmodel.IsInspectionActive, Converter={StaticResource BoolINV_Converter}}"
                            Click="StartManualInspection_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" MinWidth="100"/>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="5">工程名称</TextBlock>
                <ComboBox Grid.Column="1" IsEditable="False" SelectedIndex="{Binding DataModel.Settingmodel .prjselected,UpdateSourceTrigger=PropertyChanged}"  p:ComboBoxHelper.CornerRadius="15,0,0,15" Padding="15,0" ItemsSource="{Binding DataModel.Settingmodel.Prjs}" />
                <Button Grid.Column="2" x:Name="ChangePrj" p:ButtonHelper.CornerRadius="0,15,15,0" Background="#101010" Foreground="WhiteSmoke"  Click="ChangePrj_Click" >切换工程</Button>
                <Button Grid.Column="3" Margin="8,0,0,0" Padding="14,0"
                        Background="#176B4D" Foreground="White"
                        p:ButtonHelper.CornerRadius="4"
                        Click="InspectionRecipeConfig_Click">点检配置</Button>
            </Grid>
        </Grid>

        <ListBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" p:ListBoxHelper.CornerRadius="5"
                 BorderBrush="#55222222" Background="Gray"
                 p:ListBoxHelper.ItemsSelectedBackground="#55FF0000" 
                 SelectionChanged="ListBox_SelectionChanged"
                 SelectedIndex="{Binding DataModel.Processmodel.selectedindex}"  
                 MouseDoubleClick="ListBox_MouseDoubleClick" Margin="5,0,5,0"  
                 ItemsSource="{Binding DataModel.Processmodel.Tools}" 
                 >
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ctr:Toolcontrol Height="{Binding Source={StaticResource Locator},Path=Main.DataModel.Settingmodel.EffectiveImageSize}"
                                     Width="{Binding Source={StaticResource Locator},Path=Main.DataModel.Settingmodel.EffectiveImageSize}"
                                     DataContext="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!--<Button Grid.Row="1" Grid.Column="1" Click="Button_Click">设置</Button>-->
        <Grid Grid.Row="1" Grid.Column="2"  IsEnabled="{Binding DataModel.Settingmodel.permission }"
              >
            <!--<Grid Grid.Row="1" Grid.Column="2" Visibility="{Binding DataModel.Settingmodel.permission ,Converter={StaticResource Bool2Visible_Converter}}" >-->
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button   Grid.Row="0" Grid.Column="0"   Background="#101010" Foreground="White"  Command="{Binding AddToolCMD}"    p:ButtonHelper.CornerRadius="15,0,0,0">追加</Button>
            <Button   Grid.Row="0" Grid.Column="1"   Background="#101010" Foreground="White"  Command="{Binding InsertToolCMD}" >插入</Button>
            <Button   Grid.Row="1" Grid.Column="0"   Background="#101010" Foreground="White"  Command="{Binding CopyToolCMD}" Grid.ColumnSpan="2"  >复制</Button>
            <Button   Grid.Row="2" Grid.Column="0"   Background="#101010" Foreground="White"  Command="{Binding DeleteToolCMD}" >删除</Button>
            <Button   Grid.Row="2" Grid.Column="1"   Background="#101010" Foreground="White"  Command="{Binding ClearToolCMD}"  p:ButtonHelper.CornerRadius="0,0,15,0">清空</Button>
        </Grid>

        <!-- 报工板块：状态记录与配置区域各自滚动，紧凑布局保持关键信息可达。 -->
        <Grid x:Name="ReportPanel"
              Grid.Row="1" Grid.Column="3" Grid.RowSpan="3" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 报工标题 - 增强显著程度 -->
            <TextBlock x:Name="ReportTitle" Grid.Row="0" Text="生产报工" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,8" Foreground="DarkBlue"
                       Effect="{DynamicResource DropShadowEffect}"/>

            <!-- SN输入区域 - 减小字体突出主次 -->
            <GroupBox x:Name="ProductInfoGroup" Grid.Row="1" Header="产品信息" Margin="0,5" FontSize="13" FontWeight="Normal">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="产品SN:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Name="txtProductSN"
                             Text="{Binding DataModel.Processmodel.CurrentProductSN, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="txtProductSN_TextChanged"
                             AcceptsReturn="True"
                             Margin="5" Padding="5" FontSize="14"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="检测状态:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding DataModel.Processmodel.CanStartDetection, Converter={StaticResource Bool2DetectionStatus}}"
                               VerticalAlignment="Center" Margin="5" FontWeight="Bold" FontSize="13"
                               Foreground="{Binding DataModel.Processmodel.CanStartDetection, Converter={StaticResource Bool2StatusColor}}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="扫码状态:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding DataModel.Processmodel.ScanCodeStatus}"
                               VerticalAlignment="Center" Margin="5" FontWeight="Bold" FontSize="13"
                               Foreground="{Binding DataModel.Processmodel.ScanCodeStatusColor}"/>

                    <Button Grid.Row="3" Grid.ColumnSpan="2" Name="btnClearSN" Content="清空SN"
                            Click="btnClearSN_Click" Margin="5" Padding="5" FontSize="12"/>
                </Grid>
            </GroupBox>

            <!-- 报工状态显示 -->
            <GroupBox x:Name="ReportStatusGroup" Grid.Row="2" Header="报工状态" Margin="0,5" FontSize="13" FontWeight="Normal">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 当前报工状态 -->
                    <TextBlock Grid.Row="0" Text="{Binding DataModel.Processmodel.ReportWorkStatus}"
                               Foreground="{Binding DataModel.Processmodel.ReportWorkStatusColor}"
                               FontSize="14" FontWeight="Bold" Margin="5"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>

                    <!-- 报工成功记录 -->
                    <ScrollViewer x:Name="ReportSuccessLogScroll"
                                  Grid.Row="1" MaxHeight="180" Margin="0,5,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DataModel.Processmodel.ReportWorkSuccessLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Margin="2"
                                               Foreground="Green" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <!-- 报工配置区域 - 减小字体突出主次 -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
            <GroupBox x:Name="ReportConfigGroup" Header="报工配置" Margin="0,5" FontSize="13" FontWeight="Normal">
                <Grid x:Name="ReportConfigGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StationCodeLabel" Grid.Row="0" Grid.Column="0" Text="工位号:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Name="txtStationCode"
                             Text="{Binding DataModel.Settingmodel.ReportWorkConfig.StationCode, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding DataModel.Settingmodel.permission}"
                             TextChanged="txtStationCode_TextChanged"
                             Margin="5" Padding="5" FontSize="12"
                             Background="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigBackground}}"
                             BorderBrush="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigBorder}}"/>

                    <TextBlock x:Name="ProcedureNameLabel" Grid.Row="1" Grid.Column="0" Text="工序名称:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Name="txtProcedureName"
                             Text="{Binding DataModel.Settingmodel.ReportWorkConfig.ProcedureName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding DataModel.Settingmodel.permission}"
                             TextChanged="txtProcedureName_TextChanged"
                             Margin="5" Padding="5" FontSize="12"
                             Background="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigBackground}}"
                             BorderBrush="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigBorder}}"/>

                    <TextBlock x:Name="ProcedureCodeLabel" Grid.Row="2" Grid.Column="0" Text="工序码:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Name="txtProcedureCode"
                             Text="{Binding DataModel.Settingmodel.ReportWorkConfig.ProcedureCode, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding DataModel.Settingmodel.permission}"
                             TextChanged="txtProcedureCode_TextChanged"
                             Margin="5" Padding="5" FontSize="12"
                             Background="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigBackground}}"
                             BorderBrush="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigBorder}}"/>

                    <TextBlock x:Name="EquipmentNumberLabel" Grid.Row="3" Grid.Column="0" Text="设备编号:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Name="txtEquipmentNumber"
                             Text="{Binding DataModel.Settingmodel.ReportWorkConfig.EquipmentNumber, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding DataModel.Settingmodel.permission}"
                             TextChanged="txtEquipmentNumber_TextChanged"
                             Margin="5" Padding="5" FontSize="12"
                             Background="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigBackground}}"
                             BorderBrush="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigBorder}}"/>

                    <TextBlock x:Name="AutoReportLabel" Grid.Row="4" Grid.Column="0" Text="自动报工:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" Name="chkEnableAutoReportWork"
                              IsChecked="{Binding DataModel.Settingmodel.ReportWorkConfig.EnableAutoReportWork}"
                              IsEnabled="{Binding DataModel.Settingmodel.permission}"
                              Checked="chkEnableAutoReportWork_Checked"
                              Unchecked="chkEnableAutoReportWork_Unchecked"
                              VerticalAlignment="Center" Margin="5" FontSize="12"
                              Foreground="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigForeground}}"/>

                    <TextBlock x:Name="ScanAutoLabel" Grid.Row="5" Grid.Column="0" Text="扫码触发自动执行:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <CheckBox Grid.Row="5" Grid.Column="1" Name="chkEnableScanAutoTriggerStages"
                              IsChecked="{Binding DataModel.Settingmodel.EnableScanAutoTriggerStages}"
                              IsEnabled="{Binding DataModel.Settingmodel.permission}"
                              Checked="chkEnableScanAutoTriggerStages_Checked"
                              Unchecked="chkEnableScanAutoTriggerStages_Unchecked"
                              VerticalAlignment="Center" Margin="5" FontSize="12"
                              Foreground="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigForeground}}"/>

                    <TextBlock x:Name="SerialSoftwareTriggerLabel" Grid.Row="6" Grid.Column="0" Text="串口软件触发扫码:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"
                               ToolTip="关闭后由物理IO触发扫码，软件只通过串口接收条码"/>
                    <CheckBox Grid.Row="6" Grid.Column="1" Name="chkEnableSerialSoftwareTrigger"
                              IsChecked="{Binding DataModel.Settingmodel.EnableSerialSoftwareTrigger}"
                              IsEnabled="{Binding DataModel.Settingmodel.permission}"
                              Checked="chkEnableSerialSoftwareTrigger_Changed"
                              Unchecked="chkEnableSerialSoftwareTrigger_Changed"
                              VerticalAlignment="Center" Margin="5" FontSize="12"
                              ToolTip="关闭后由物理IO触发扫码，软件只通过串口接收条码"
                              Foreground="{Binding DataModel.Settingmodel.permission, Converter={StaticResource Bool2ConfigForeground}}"/>
                </Grid>
            </GroupBox>

            <!-- 上岗人员信息 - 减小字体突出主次 -->
            <GroupBox x:Name="WorkerInfoGroup" Header="上岗人员" Margin="0,5" FontSize="13" FontWeight="Normal">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding DataModel.Processmodel.CurrentWorkerName}"
                               VerticalAlignment="Center" Margin="5" FontWeight="Bold" FontSize="13"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="工号:" VerticalAlignment="Center"
                               Margin="5" FontSize="12" Foreground="DimGray"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding DataModel.Processmodel.CurrentWorkerID}"
                               VerticalAlignment="Center" Margin="5" FontWeight="Bold" FontSize="13"/>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Name="btnRefreshWorker" Content="刷新上岗人员"
                                Click="btnRefreshWorker_Click" Margin="5" Padding="5" FontSize="12"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding DataModel.Processmodel.RefreshWorkerStatus}"
                                   Foreground="{Binding DataModel.Processmodel.RefreshWorkerStatusColor}"
                                   VerticalAlignment="Center" Margin="5" FontSize="11" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </GroupBox>

              </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="ToolDetailPanel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>

            </Grid.RowDefinitions>

            <GroupBox>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel>
                        <TextBlock Text="{Binding DataModel.Processmodel.tool.Index}"/>
                        <TextBlock Text="{Binding DataModel.Processmodel.tool.Name}"/>
                    </WrapPanel>
                    <Grid Grid.Row="1"   Visibility="{Binding DataModel.Processmodel.tool.TestMode,Converter={StaticResource TestMode2Visibility_Barcode}}">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{Binding DataModel.Processmodel.tool.TestMode,Converter={StaticResource TestMode2Visibility_Barcode}}">二维码内容:</TextBlock>

                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding DataModel.Processmodel.tool.BarcodeStr}" />
                    </Grid>

                    <Grid Grid.Row="2"  Visibility="{Binding DataModel.Processmodel.tool.TestMode,Converter={StaticResource TestMode2Visibility_ShapeMatch}}">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">X坐标:</TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">Y坐标:</TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">X偏移:</TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">Y偏移:</TextBlock>
                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">角度:</TextBlock>
                        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">分值:</TextBlock>

                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding DataModel.Processmodel.tool.ActualX,StringFormat={}{0:F1}}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding DataModel.Processmodel.tool.ActualY,StringFormat={}{0:F1}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding DataModel.Processmodel.tool.DeltaX,StringFormat={}{0:F4}}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding DataModel.Processmodel.tool.DeltaY,StringFormat={}{0:F4}}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding DataModel.Processmodel.tool.ActualAngle,StringFormat={}{0:F3}}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding DataModel.Processmodel.tool.ActualScore,StringFormat={}{0:F3}}"/>


                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">pixel</TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">pixel</TextBlock>
                        <!--<TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">mm</TextBlock>-->
                        <!--<TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">mm</TextBlock>-->

                    </Grid>
                    <Grid Grid.Row="2"  Visibility="{Binding DataModel.Processmodel.tool.TestMode,Converter={StaticResource TestMode2Visibility_Dimension}}">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">实际面积:</TextBlock>

                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding DataModel.Processmodel.tool.ActualDimension,StringFormat={}{0:F1}}"/>




                    </Grid>


                </Grid>
            </GroupBox>
          
            <GroupBox Header="累积二维码" Grid.Row="1">
                <TextBox IsEnabled="False" FontSize="12" TextWrapping="Wrap" MaxWidth="400" MinWidth="300" MinHeight="100"  Text="{Binding DataModel.Processmodel.Barcodes}" />
            </GroupBox>
            <Button x:Name="ClearBarcodes" Grid.Row="1" Background="OrangeRed" Foreground="WhiteSmoke" Padding="20,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                   Click="ClearBarcodes_Click" >清空二维码</Button>
            <DataGrid ItemsSource="{Binding DataModel.Recordmodel.workLog}" AutoGenerateColumns="False" Grid.Row="2" >
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding}" FontSize="12" />
                </DataGrid.Columns>
            </DataGrid>

            <ListBox ItemsSource="{Binding DataModel.Processmodel.SNList}" Grid.Row="3" MinHeight="40" Padding="5" Margin="2">

            </ListBox>
        </Grid>
        <halcon:HWindowControlWPF Grid.Row="2" Name="Hwindow" Visibility="Hidden" />
        <C:CameraControl Grid.Row="3" Name="cameractr" DataContext="{Binding DataModel.Settingmodel.camedata}"/>
       
        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock   Text="{Binding DataModel.Processmodel.Status}" 
                   HorizontalAlignment="Left"
                   Margin="20,5,5,5"
                   FontSize="20"
                   Foreground="{Binding  DataModel.Processmodel.StatusColor }"
                   
                   />
            <ListBox
                 p:ListBoxHelper.CornerRadius="5" HorizontalAlignment="Center" 
                 VerticalAlignment="Center"
                  Background="White" BorderThickness="0"
                 p:ListBoxHelper.ItemsSelectedBackground="#55FF0000" 
                 SelectionChanged="ListBox_SelectionChanged"
                 SelectedIndex="{Binding DataModel.Processmodel.selectedindex}"  
                 MouseDoubleClick="ListBox_MouseDoubleClick" Margin="5,0,5,0"  
                 ItemsSource="{Binding DataModel.Processmodel.Tools}" >
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel  Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!--<ctr:Toolcontrol MinHeight="140" MinWidth="140" DataContext="{Binding}"/>-->
                        <!--<Rectangle Width="10" Height="10" />-->
                        <Grid DataContext="{Binding}">
                            <TextBlock  Background="{Binding StatusColor}" Text="{Binding Index,StringFormat={}{0:00}}" Padding="2">
                                <TextBlock.ToolTip>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Vertical" >
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock    Foreground="Orange" Text="{Binding Index }"/>
                                            <TextBlock    Foreground="DarkBlue" Text="{Binding Name }" Margin="0,0,10,0"/>
                                            <TextBlock HorizontalAlignment="Center">模板照片</TextBlock>
                                        </StackPanel>
                                        <Image   HorizontalAlignment="Center" Source="{Binding BitmapSource}"/>
                                    </StackPanel>
                                </TextBlock.ToolTip>
                        </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </DockPanel>
        
        <WrapPanel x:Name="FooterStatusPanel" Grid.Row="4" HorizontalAlignment="Center" Grid.ColumnSpan="4" >

            <!--<TextBlock Margin="10,0" Text="{Binding DataModel.Processmodel.ImageNum,StringFormat=照片数:{0}}"  />-->
            <TextBlock Margin="10,0" Text="{Binding DataModel.Settingmodel.RobotConnect.IsConnected,StringFormat=机器人连接:{0}}"  />
            <!--<TextBlock Margin="10,0" Text="{Binding DataModel.Settingmodel.SoftConnect.IsConnected,StringFormat=PC连接:{0}}" />-->
            <TextBlock Margin="10,0" Text="{Binding DataModel.Processmodel.ToolIndex,StringFormat=工具编号:{0}}"/>
            <TextBlock Margin="10,0" Text="{Binding DataModel.Processmodel.RCMD,StringFormat=接收:{0}}"/>
            <TextBlock Margin="10,0" Text="{Binding DataModel.Processmodel.Trig_IO.IOStatusDisplayText}" 
                       Background="{Binding DataModel.Processmodel.Trig_IO.IOstatusBackGround}" 
                       Foreground="{Binding DataModel.Processmodel.Trig_IO.IOStatusForeGround}"
                       Padding="10,2"
                       />
            <TextBlock Margin="10,0" Text="{Binding DataModel.Processmodel.CameraStatus,StringFormat=相机:{0}}"
                       Foreground="{Binding DataModel.Processmodel.CameraStatusColor}"
                       Padding="10,2"
                       />

            <!--<CheckBox Margin="10,0" IsChecked="{Binding DataModel.Settingmodel.ImageSaveSetting.SaveOK }">保存OK</CheckBox>
            <CheckBox Margin="10,0" IsChecked="{Binding DataModel.Settingmodel.ImageSaveSetting.SaveNG }">保存NG</CheckBox>-->
            <TextBlock MaxWidth="260"
                       Text="{Binding DataModel.Processmodel.Scannerstr,StringFormat=扫码器:{0}}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       ToolTip="{Binding DataModel.Processmodel.Scannerstr}"/>
            <Button Name="Send2Soft_btn" Click="Send2Soft_btn_Click" Visibility="Collapsed" >发送测试Soft</Button>
            <Button Name="Send2Robot_btn" Click="Send2Robot_btn_Click" Visibility="Collapsed">发送测试Robot</Button>
            <Button Name="Barcodetest_btn"  Click="Barcodetest_btn_Click" Visibility="Collapsed">二维码识别测试</Button>
            <Button Name="tooltest" Click="tooltest_Click" Content="照片测试"
                    IsEnabled="{Binding CanRunManualImageTest}" />
            <Button x:Name="scannertrig" Click="scannertrig_Click" Content="扫码测试"/>
        </WrapPanel>
    </Grid>
</p:WindowX>
