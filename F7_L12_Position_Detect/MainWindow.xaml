        <Style TargetType="Button"
               BasedOn="{StaticResource {ComponentResourceKey ResourceId=CloseButtonStyle, TypeInTargetAssembly={x:Type p:WindowXCaption}}}">
            <Setter Property="VerticalAlignment"
