<p:WindowX x:Class="F7_L12_Position_Detect.View.DynamicPasswordAuthWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:p="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
           mc:Ignorable="d"
           Title="动态密码授权"
           Height="380"
           Width="520"
           WindowStartupLocation="CenterScreen"
           p:WindowXCaption.Height="30"
           p:WindowXCaption.Background="#fd433a"
           p:WindowXCaption.Foreground="WhiteSmoke">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF7E6" CornerRadius="6" Padding="10" BorderBrush="#FFD591" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="说明：" FontWeight="Bold" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="申请密码后系统会向可审批管理员发送动态密码。联系接收人获取 6 位密码后在下方验证。" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
            <TextBlock VerticalAlignment="Center" Text="申请原因：" Width="70" />
            <TextBlock x:Name="reasonTextBlock" VerticalAlignment="Center" Text="AOI 工具编辑/参数修改" />
            <Button x:Name="requestButton" Margin="16,0,0,0" MinWidth="110" Height="28"
                    Background="#fd433a" Foreground="WhiteSmoke" p:ButtonHelper.CornerRadius="14"
                    Click="RequestButton_Click">申请密码</Button>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="已发送接收人" Margin="0,0,0,10" BorderBrush="#fd433a" p:GroupBoxHelper.HeaderForeground="#fd433a">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="receiverListBox" Grid.Row="0" />
                <TextBlock x:Name="requestStatusTextBlock" Grid.Row="1" Margin="0,8,0,0" Foreground="#666" Text="尚未申请动态密码" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="输入动态密码" BorderBrush="#fd433a" p:GroupBoxHelper.HeaderForeground="#fd433a">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="passwordBox" Grid.Column="0" Height="28" BorderThickness="0,0,0,1"
                             BorderBrush="Black" HorizontalContentAlignment="Center" />
                <Button x:Name="verifyButton" Grid.Column="1" Margin="12,0,0,0" MinWidth="110" Height="28"
                        Background="#fd433a" Foreground="WhiteSmoke" p:ButtonHelper.CornerRadius="14"
                        Click="VerifyButton_Click">验证</Button>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button MinWidth="90" Height="28" p:ButtonHelper.CornerRadius="14" Click="CancelButton_Click">取消</Button>
        </StackPanel>
    </Grid>
</p:WindowX>
