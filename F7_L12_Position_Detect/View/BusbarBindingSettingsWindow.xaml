<p:WindowX x:Class="F7_L12_Position_Detect.View.BusbarBindingSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="https://opensource.panuon.com/wpf-ui"
        Title="母排组装设置" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        p:WindowXCaption.Height="40" p:WindowXCaption.Background="#2F3B47"
        p:WindowXCaption.Foreground="White">
    <StackPanel Margin="20">
        <TextBlock Text="母排组装：使用 SerializedProductAssemble 生成成品 SN，再用返回 SN 完成组装 OK 报工，成功后进入 AOI 检测。"
                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Grid IsEnabled="{Binding Source={StaticResource Locator}, Path=Main.DataModel.Settingmodel.permission}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.ColumnSpan="2" Content="启用母排组装自动组装" FontSize="14" Margin="0,0,0,16"
                      IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="1" Text="组装工位号" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,10"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="8,5" FontSize="14" MinHeight="32"
                     Text="{Binding StationCode, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="MES 中执行母排组装取号和组装报工的工位；上岗人员从该工位查询"/>
            <TextBlock Grid.Row="2" Text="组装工序码" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,10"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="8,5" FontSize="14" MinHeight="32"
                     Text="{Binding ProcedureCode, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="MES 中执行母排组装取号和组装报工的标准工序码，例如现场验证的 00025"/>
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" FontSize="12" Foreground="DimGray" TextWrapping="Wrap"
                       Text="组装工位、组装工序由 MES 确认；母排组装取号和组装报工使用这里的参数，AOI 检测和报工使用主界面报工配置。"/>
        </Grid>
        <TextBlock x:Name="RuntimeStatus" Margin="0,16,0,4" FontSize="13"/>
        <TextBlock Text="保存后立即生效，下一次扫码按新配置执行。" FontSize="12" Foreground="#B45F06"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" Click="Save_Click" MinWidth="80" MinHeight="34" Padding="12,6"
                    Margin="0,0,10,0" FontSize="14" Background="#176B4D" Foreground="White"
                    IsEnabled="{Binding Source={StaticResource Locator}, Path=Main.DataModel.Settingmodel.permission}"/>
            <Button Content="取消" Click="Cancel_Click" MinWidth="80" MinHeight="34" Padding="12,6" FontSize="14"/>
        </StackPanel>
    </StackPanel>
</p:WindowX>
