<p:WindowX x:Class="F7_L12_Position_Detect.View.InspectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F7_L12_Position_Detect.View"
        mc:Ignorable="d"
        xmlns:p="https://opensource.panuon.com/wpf-ui"
        Title="点检提示" Height="300" Width="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        p:WindowXCaption.Height="40" 
        p:WindowXCaption.Background="Orange" 
        p:WindowXCaption.Foreground="White">
    <p:WindowX.Resources>
        <local:BoolToOKButtonColorConverter x:Key="BoolToOKButtonColorConverter" />
        <local:BoolToNGButtonColorConverter x:Key="BoolToNGButtonColorConverter" />
        <local:BoolToOKButtonTextConverter x:Key="BoolToOKButtonTextConverter" />
        <local:BoolToNGButtonTextConverter x:Key="BoolToNGButtonTextConverter" />
    </p:WindowX.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="需要完成点检"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="点检周期已到期，请完成以下点检："
                       FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap" HorizontalAlignment="Center"/>

            <Grid Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="btnOKInspection"
                        Click="BtnOKInspection_Click"
                        Padding="20,14" FontSize="16" FontWeight="Bold"
                        HorizontalAlignment="Stretch"
                        p:ButtonHelper.CornerRadius="5"
                        Background="{Binding DataModel.Processmodel.OKInspectionCompleted, Converter={StaticResource BoolToOKButtonColorConverter}}"
                        Foreground="White"
                        Content="{Binding DataModel.Processmodel.OKInspectionCompleted, Converter={StaticResource BoolToOKButtonTextConverter}}"/>

                <Button Grid.Column="2" Name="btnNGInspection"
                        Click="BtnNGInspection_Click"
                        Padding="20,14" FontSize="16" FontWeight="Bold"
                        HorizontalAlignment="Stretch"
                        p:ButtonHelper.CornerRadius="5"
                        Background="{Binding DataModel.Processmodel.NGInspectionCompleted, Converter={StaticResource BoolToNGButtonColorConverter}}"
                        Foreground="White"
                        Content="{Binding DataModel.Processmodel.NGInspectionCompleted, Converter={StaticResource BoolToNGButtonTextConverter}}"/>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="提示：开启“扫码触发自动执行”后，点检码确认成功即自动检测；关闭时由PLC触发检测"
                   FontSize="12" Foreground="Gray"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,0" TextWrapping="Wrap"/>
    </Grid>
</p:WindowX>
